# AI SpendWise — systemd 서비스 템플릿
# 복사 위치: /etc/systemd/system/spendwise.service
# 적용: sudo systemctl daemon-reload && sudo systemctl enable --now spendwise

[Unit]
Description=AI SpendWise FastAPI backend
After=network.target

[Service]
User=ubuntu
# .env와 google_ocr_key.json이 이 디렉토리에 있어야 합니다 (load_dotenv가 여기서 읽음)
WorkingDirectory=/home/ubuntu/capstone
# 프로덕션은 127.0.0.1 바인딩 — 외부 접근은 반드시 nginx(HTTPS)를 거치게 합니다.
ExecStart=/home/ubuntu/capstone/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
