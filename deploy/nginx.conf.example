# AI SpendWise — nginx 설정 템플릿
# 복사 위치: /etc/nginx/sites-available/spendwise → sites-enabled에 심볼릭 링크
# YOUR_DOMAIN을 실제 도메인으로 바꾸세요. HTTPS는 certbot이 이 파일을 자동 수정합니다.

server {
    listen 80;
    server_name YOUR_DOMAIN;

    # ── 프론트엔드 (Vite 빌드 결과물) ──
    root /var/www/spendwise/dist;
    index index.html;

    location / {
        # SPA 라우팅: 어떤 경로든 index.html로
        try_files $uri $uri/ /index.html;
    }

    # ── 백엔드 API 프록시 ──
    # 끝의 슬래시가 중요: /api/login → 127.0.0.1:8000/login 으로 프리픽스가 제거됩니다.
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # nginx 기본값은 1MB — 영수증 업로드(최대 10MB)가 413으로 막히지 않게 여유를 둡니다.
        client_max_body_size 12m;
    }

    # ── 영수증 이미지 등 백엔드 static ──
    location /static/ {
        proxy_pass http://127.0.0.1:8000/static/;
    }
}
